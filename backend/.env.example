# FlowForge backend environment template.
# Copy to `.env` and fill in real values: cp .env.example .env

# Express server port
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/flowforge

# Browser origin allowed by CORS (must match the frontend URL)
CORS_ORIGIN=http://localhost:3000

# JWT signing secrets - use long, random strings (32+ chars) in production
ACCESS_TOKEN_SECRET=change_me_access_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRY=7d
